# Copy to taxappeal-qualify/.env and fill in. Never commit .env.
# Nothing here is needed for tests or `npm run demo`; it only enables the real LLM review.
#
# The CLI reads taxappeal-qualify/.env first, then the repo-root .env. If the team already keeps
# VETTA_API_KEY / VETTA_API_BASE_URL in the root .env, Qualify picks those up and you can
# leave the NAIVE_* lines blank.

# Naïve API key (create one with `vetta keys create`; shown only once). VETTA_API_KEY also works.
NAIVE_API_KEY=

# Naïve API base URL (default shown). VETTA_API_BASE_URL also works.
NAIVE_API_BASE_URL=https://api.vetta.sh

# Model id for the LLM review, exactly as `vetta models list --human` lists it.
QUALIFY_MODEL=

# Optional: stronger model used only when a high-value lead's first review is worried.
QUALIFY_ESCALATION_MODEL=

# Optional: IANA time zone used for "today" (defaults to the machine's).
QUALIFY_TIMEZONE=America/Los_Angeles
